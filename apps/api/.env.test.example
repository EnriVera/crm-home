# Base de datos para los tests de integración de la API.
#
# IMPORTANTE: esta URL NUNCA puede apuntar a la base de desarrollo
# (`crm_home`). Los tests de integración borran tablas: si apuntan a la base
# de desarrollo, borran los datos del dueño. Ya pasó — `bun run test` vació
# `crm_home` por completo.
#
# El guardarraíl vive en `src/infrastructure/kysely/test-db.ts`:
#   - exige que el nombre de la base termine en `_test`,
#   - verifica con `current_database()` que la conexión real es la de test,
#   - aborta los tests de integración si la URL falta (NO los saltea en
#     silencio: un skip esconde bugs).
#
# Setup en una máquina nueva (desde `apps/api`):
#
#   cp .env.test.example .env.test
#   make up                                    # postgres + mailpit
#   docker compose exec -T postgres psql -U crm -d postgres \
#     -c 'CREATE DATABASE crm_home_test;'
#   DATABASE_URL=postgres://crm:crm@localhost:5432/crm_home_test bun run db:migrate
#   bun run test:db
#
# Las migraciones también se aplican solas: el bootstrap de la suite corre
# `ensureTestSchema()` antes de cada suite de integración, que crea la base
# si falta y aplica las migraciones pendientes.
TEST_DATABASE_URL=postgres://crm:crm@localhost:5432/crm_home_test

# Vacía a propósito: durante los tests, `DATABASE_URL` se apunta a la base
# de test en runtime. Si esta variable quedara con la URL de desarrollo,
# cualquier código que la lea fuera de los tests tocaría `crm_home`.
DATABASE_URL=

# Mailpit (lo levanta `make up`): el test de integración del sender SMTP
# necesita esta variable. Sin ella, `bun run test:db` saltea ese test.
SMTP_URL=smtp://localhost:1025

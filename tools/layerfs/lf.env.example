# Copy to lf.env (gitignored) and adjust. Sourced by the `lf` wrapper; $HOME expands at source time.
# The project folder itself NEVER moves: init reads it once into the Store; the Store
# must live on a LOCAL ext4/xfs/btrfs filesystem (repo on NTFS/fuseblk is fine as source).

LAYERFS_CHECKOUT=$HOME/tools/layerfs
LAYERFS_PROJECT=crm-home
LAYERFS_HOME=$HOME/.local/share/layerfs/crm-home
LAYERFS_STORE_PATH=$LAYERFS_HOME/global/store.sqlite

# One-time init reads this tree (code + .git + node_modules + ignored files). Large tree: long timeout (ms).
LAYERFS_SOURCE="/run/media/enri/DISCO DURO/crm-home/crm"
LAYERFS_INIT_TIMEOUT=1200000

# Copy to lf.env (gitignored) and adjust. Sourced by the `lf` wrapper; $HOME expands at source time.
# The project folder itself NEVER moves: init reads it once into the Store.
#
# Store topology: the Store lives INSIDE a plain docker volume (bind volumes are
# refused: "exact plain local VM volume"). Sandbox containers mount that volume
# at /layerfs-store. All lf commands run as root (sudo re-exec in the wrapper),
# so the host opens the Store through /var/lib/docker. Bootstrap:
#   docker volume create layerfs-crm-home
#   docker run --rm -v layerfs-crm-home:/dest -v <host-store-dir>:/src:ro \
#     layerfs-crm-runtime:latest sh -c 'cp -a /src/. /dest/ && chmod 700 /dest /dest/crm-home'

LAYERFS_CHECKOUT=$HOME/tools/layerfs
LAYERFS_PROJECT=crm-home
LAYERFS_HOME=/var/lib/docker/volumes/layerfs-crm-home/_data
LAYERFS_STORE_PATH=$LAYERFS_HOME/global/store.sqlite

# One-time init reads this tree (code + .git + node_modules + ignored files). Large tree: long timeout (ms).
# NOTE: init refuses sockets/FIFOs in the tree — kill the codegraph MCP daemon and
# rm -rf .codegraph first (it recreates the socket lazily; the index rebuilds).
LAYERFS_SOURCE="/run/media/enri/DISCO DURO/crm-home/crm"
LAYERFS_INIT_TIMEOUT=1200000

# Sandbox deployment (lf run): LAYERFS_IMAGE is an immutable digest
# (layerfs-crm-runtime: node:24-bookworm + bun 1.4.4 + rust 1.85.1 + chromium).
# LAYERFS_DAEMON is the host path of the daemon binary the engine uploads into
# each sandbox container (built inside rust:1.85.1-bookworm, see ~/src/layerfs-runtime).
LAYERFS_DOCKER=/var/run/docker.sock
LAYERFS_IMAGE=sha256:1254f3967197b7d112f6cd8f3dbc5a1bec58927899015b76c134224d3a407e08
LAYERFS_VOLUME=layerfs-crm-home
LAYERFS_DAEMON=/home/enri/layerfs/daemon/layerfs-daemon

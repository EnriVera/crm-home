# Conexión PostgreSQL (leída solo por createDatabase() de @crm/api, lazy)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm_home

# Vacío → telemetría OpenTelemetry no-op (ver apps/api/src/infrastructure/otel/)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Puertos de desarrollo
API_PORT=3000
WEB_PORT=5173

# --- Email transaccional (transactional-email) ---
# Vacío o ausente → el selector `createEmailSender` cae al adapter de consola
# (preserva el comportamiento previo). Para enviar SMTP real, descomentar y
# apuntar a Mailpit local (`make mail-up`) o a un relay corporativo.
# Formato: smtp://[user:pass@]host:port  o  smtps://... para TLS directo (465).
# SMTP_URL=smtp://localhost:1025

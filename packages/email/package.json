{
  "name": "@crm/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && bun run scripts/write-types.ts",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.typecheck.json",
    "test": "bun test",
    "export": "octane-email export -d src/templates --outDir out"
  },
  "dependencies": {
    "@octanejs/email": "0.0.3"
  },
  "devDependencies": {
    "@crm/tsconfig": "workspace:*",
    "@octanejs/email-cli": "0.0.3",
    "vite": "8.2.2"
  }
}

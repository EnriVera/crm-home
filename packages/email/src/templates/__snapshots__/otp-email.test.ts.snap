exports[`OtpEmail renderiza el HTML con el código, expiración y disclaimer 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="es"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"><meta name="x-apple-disable-message-reformatting"></head><body dir="ltr" lang="en" style="background-color:#f6f6f6;padding:0;"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td dir="ltr" lang="en" style="background-color:#f6f6f6;font-family:sans-serif;padding:20px;"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:480px;margin:0 auto;background-color:#ffffff;border-radius:8px;"><tbody><tr style="width: 100%;"><td style="padding:24px;"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td><p style="font-size:20px;line-height:24px;font-weight:bold;margin-bottom:16px;margin-top:16px;">Tu código de acceso</p><p style="font-size:16px;line-height:24px;margin-bottom:16px;margin-top:16px;">Ingresá el siguiente código para continuar:</p><p style="font-size:32px;line-height:24px;font-weight:bold;letter-spacing:6px;padding:16px;background-color:#f0f0f0;text-align:center;border-radius:8px;margin-bottom:16px;margin-top:16px;">041283</p><p style="font-size:14px;line-height:24px;color:#666666;margin-bottom:8px;margin-top:16px;">Este código expira en 10 minutos.</p><p style="font-size:14px;line-height:24px;color:#666666;margin-top:16px;margin-bottom:16px;">Si no lo solicitaste, ignorá este mensaje.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;
